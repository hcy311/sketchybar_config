<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hcy.loon2-watchdog</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/hcy/.config/sketchybar/loon2-watchdog/ensure_loon2_running.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>5</integer>

  <key>StandardOutPath</key>
  <string>/tmp/loon2-watchdog.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/loon2-watchdog.stderr.log</string>
</dict>
</plist>
